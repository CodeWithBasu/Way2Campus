generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  role      String   // "STUDENT", "DRIVER", "ADMIN"
  name      String
  email     String?  @unique
  phone     String?  @unique
  busNumber String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusRoute {
  id        String   @id @default(cuid())
  busNumber String   @unique // e.g., "15"
  driverId  String?  // Reference to User if we want to link
  stops     String   // JSON string or comma separated
  schedule  String   // JSON string
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  authorId  String   // Reference to User
  createdAt DateTime @default(now())
}
